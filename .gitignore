# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local editor config (e.g. SonarLint connected mode)
.vscode/

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# test output
coverage/
reports/
.stryker-tmp/

# build artifacts
*.apk
*.aab
*.ipa

# Firebase credentials. Not secret exactly, but they are per-project and per
# developer — app.config.js treats their absence as "Firebase not configured"
# and builds a working, uninstrumented app.
google-services.json

# ⚠️ Play service account keys. Nothing above catches these: *.key and *.p8 do
# not match a .json, and this repository is PUBLIC. A key here has upload
# rights to the store listing. See docs/PLAY-SERVICE-ACCOUNT.md — the file
# belongs OUTSIDE the repository; this is the safety net, not the plan.
*service-account*.json
play-store-credentials.json
GoogleService-Info.plist

# Generated store assets — screenshots, videos, archived cuts. All of it is
# re-downloadable from the screenshots and videos workflows, so none of it
# belongs in git.
#
# ⚠️ `listing/` is the EXCEPTION and must stay tracked: it is the store copy in
# three languages plus the icon and feature graphic, it is written by hand, and
# `store-listing.test.ts` fails the build when a block outgrows its field. It
# lived in `docs/` until everything store-related was gathered here.
store-assets/*
!store-assets/listing/

# Gradle state from building the local Expo modules.
modules/*/android/.gradle/
