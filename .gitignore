# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local editor config (e.g. SonarLint connected mode)
.vscode/

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# test output
coverage/
reports/
.stryker-tmp/

# build artifacts
*.apk
*.aab
*.ipa

# Firebase credentials. Not secret exactly, but they are per-project and per
# developer — app.config.js treats their absence as "Firebase not configured"
# and builds a working, uninstrumented app.
google-services.json

# ⚠️ Play service account keys. Nothing above catches these: *.key and *.p8 do
# not match a .json, and this repository is PUBLIC. A key here has upload
# rights to the store listing. See docs/PLAY-SERVICE-ACCOUNT.md — the file
# belongs OUTSIDE the repository; this is the safety net, not the plan.
*service-account*.json
play-store-credentials.json
GoogleService-Info.plist

# Generated store assets — screenshots, videos, archived cuts. All of it is
# re-downloadable from the screenshots and videos workflows, so none of it
# belongs in git.
#
# ⚠️ `listing/` is the EXCEPTION and must stay tracked: it is the store copy in
# three languages plus the icon and feature graphic, it is written by hand, and
# `store-listing.test.ts` fails the build when a block outgrows its field. It
# lived in `docs/` until everything store-related was gathered here.
store-assets/*
!store-assets/listing/
# ⚠️ The composed videos ARE tracked, deliberately. They are small — 2.3 MB for
# both, against a 25 MB .git — and they are the one asset that cannot be
# regenerated cheaply: a re-record is a different take, with different timings
# and a different onset, so "the video we published" is only recoverable if the
# file itself is kept. The screenshots are not tracked for the opposite reason:
# they re-capture identically from a workflow.
#
# ⚠️ Each release adds ~2.3 MB permanently, since git never forgets a binary.
# That is affordable here and worth knowing before it becomes a habit for
# larger assets.
#
# ⚠️ THE SHAPE MATTERS. Git will not re-include a file whose PARENT DIRECTORY is
# excluded, and `store-assets/*` excludes the version folders themselves — so a
# bare `!store-assets/*/video/**` matches nothing at all. The version
# directories have to be re-included first so git descends into them, their
# contents excluded again, and only then the video folders carved back out.
!store-assets/*/
store-assets/*/*
!store-assets/*/video/

# Gradle state from building the local Expo modules.
modules/*/android/.gradle/

# Agent worktrees. A subagent gets its own git worktree under here, which means
# a full second checkout AND its own node_modules — 740MB on 13 September —
# sitting inside the repository. ⚠️ Untracked is not enough: `git add -A` would
# happily commit all of it, and the linters below walk into it and report its
# copy of the source as this one's errors.
.claude/
