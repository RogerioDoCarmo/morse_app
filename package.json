{
  "name": "morse-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "run:android": "expo run:android --device",
    "run:ios": "expo run:ios --device",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "build:ipa": "eas build --platform ios --profile production",
    "build:apk:local": "eas build --platform android --profile preview --local",
    "build:aab:local": "eas build --platform android --profile production --local",
    "build:ipa:local": "eas build --platform ios --profile production --local",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --forceExit",
    "test:e2e": "maestro test .maestro/flows/",
    "mutation": "stryker run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!design\" \"!.stryker-tmp\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "~19.2.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
